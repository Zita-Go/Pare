<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:contentDescription="打开 Step 今日规划">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Step" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_primary" />
            <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="end" android:text="今日重点" android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="正在读取今日重点" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_next_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="从最小下一步开始" android:textSize="13sp" android:textColor="@color/widget_secondary" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="本机内容 · 离线可用" android:textSize="12sp" android:textColor="@color/widget_primary" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_capture" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/widget_capture_background" android:backgroundTint="@null"
            android:src="@drawable/pare_symbol_description" android:tint="@color/widget_primary" android:padding="14dp"
            android:contentDescription="快速收集想法" android:tooltipText="随手记" android:stateListAnimator="@null" android:elevation="0dp" />
        <Button android:id="@+id/widget_focus" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="2dp"
            android:background="@drawable/widget_primary_button" android:backgroundTint="@null" android:text="打开今日" android:textSize="14sp"
            android:stateListAnimator="@null" android:elevation="0dp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_on_primary" android:textAllCaps="false" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="4dp" android:minWidth="0dp" />
    </LinearLayout>
</LinearLayout>
